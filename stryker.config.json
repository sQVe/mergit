{
  "testRunner": "bun",
  "bun": { "timeout": 600000, "bunArgs": ["--timeout", "60000"] },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/index.ts",
    "!src/**/*Harness.ts",
    "!src/**/*Harness.tsx"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@hughescr/stryker-bun-runner"],
  "concurrency": "50%",
  "timeoutMS": 10000,
  "timeoutFactor": 4,
  "fileLogLevel": "info",
  "ignorePatterns": [".tau", "docs", "tests/*.test.ts", "dist", "CHANGELOG.md"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
