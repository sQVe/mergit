{
  "name": "mergit",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal UI for GitHub work that needs action.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "changeset": "bunx --bun changeset",
    "changeset:check": "bunx --bun changeset status --since=origin/main",
    "changeset:version": "bunx --bun changeset version && bunx --bun vp fmt",
    "check": "bun run --bun typecheck && bun run --bun style:check && bun run --bun format:check && bun run --bun knip && bun run --bun test",
    "fix": "bunx --bun vp lint --fix && bunx --bun vp fmt",
    "knip": "bunx --bun knip",
    "mutation": "bunx --bun mutation",
    "format": "bunx --bun vp fmt",
    "format:check": "bunx --bun vp fmt --check",
    "lint": "bunx --bun vp lint --deny-warnings",
    "style:check": "bunx --bun seam",
    "style:fix": "bunx --bun seam --fix",
    "prepare": "bunx --bun vp config",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:changed": "bun test --changed",
    "typecheck": "bunx --bun tsc --noEmit",
    "release:github": "bunx --bun changeset tag"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/keymap": "0.5.14",
    "@opentui/react": "0.5.14",
    "react": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@oxlint/plugins": "1.79.0",
    "@sqve/mutation": "0.1.0",
    "@sqve/seam": "0.2.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/util": "10.0.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "knip": "6.37.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
